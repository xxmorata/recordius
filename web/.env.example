# Recordius web app settings for `npm run dev` / `npm start` (copy to .env.local).
# Docker users: use the .env.example in the repository root instead.

# Postgres connection string (Neon, Supabase, RDS, Docker — any Postgres 14+).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recordius

# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs sessions and file links.
AUTH_SECRET=

# Public URL of this deployment (no trailing slash). Used in share links, file links and by the Mac app.
# On Vercel you can leave it empty: the production domain is detected.
APP_URL=http://localhost:3000

# Storage — pick one (default: files on this machine in ./storage).
# STORAGE=local
# STORAGE_DIR=./storage
#
# STORAGE=s3
# S3_BUCKET=recordius
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
#
# STORAGE=vercel-blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...   # a PRIVATE store

# Optional. "true" lets anyone create their own workspace on this server (default: invite only).
ALLOW_OPEN_SIGNUP=false
