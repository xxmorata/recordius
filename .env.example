# Recordius settings for docker compose (copy to .env). Only AUTH_SECRET and APP_URL are required.

# A long random string that signs sessions and file links. Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# The address people open in their browser (used in share links and by the Mac app).
# With the https profile this is https://<DOMAIN>.
APP_URL=http://localhost:3000

# Plain http on port 3000 is reachable from this machine only (http://localhost:3000). To try Recordius
# from other computers without a domain, set HTTP_BIND=0.0.0.0 and APP_URL=http://<server-ip>:3000 —
# fine for a quick test; for real use, set DOMAIN and use the https profile.
# HTTP_BIND=127.0.0.1
# HTTP_PORT=3000

# Only for `docker compose --profile https up -d`: your domain, already pointing at this server.
# DOMAIN=videos.example.com

# Password of the bundled database (it isn't reachable from outside the compose network).
# POSTGRES_PASSWORD=recordius

# ── Storage ────────────────────────────────────────────────────────────────────
# Default: files are kept in the `files` Docker volume on this server. Nothing else to set.
#
# Or use any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO, …):
# STORAGE=s3
# S3_BUCKET=recordius
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false     # true for MinIO / Garage / most self-hosted S3 servers

# Let anyone create their own workspace on this server (default: invite-only after the first account).
# ALLOW_OPEN_SIGNUP=false
